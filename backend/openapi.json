            "title": "Name"
          },
          "provider_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Id"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "AuthorMetadata"
      },
      "BookEditionResponse": {
        "properties": {
          "isbn10": {
            "anyOf": [
