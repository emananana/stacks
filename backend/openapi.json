          "200": {
            "description": "Replay of an already saved operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryCopyResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
