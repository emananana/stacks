        "type": "object",
        "required": [
          "isbn10",
          "isbn13",
          "title",
          "metadata_provider",
          "id",
          "fetched_at"
        ],
        "title": "BookEditionResponse"
      },
      "CopyDetails": {
        "properties": {
          "reading_status": {
            "type": "string",
            "enum": [
              "unread",
              "reading",
              "read"
            ],
            "title": "Reading Status",
            "default": "unread"
